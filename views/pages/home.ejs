<%- include('../partials/header', { page: 'home', title: 'Home', description: 'A friendly learning hub.' }) %>

<section class="hero-card">
  <div class="hero-copy">
    <p class="eyebrow">AI support for your study journey</p>
    <h1>Understand Smarter, Not Harder</h1>
    <p>
      Study Buddy AI now lives in Telegram, where students can ask questions, get calm explanations,
      and keep learning at a pace that feels comfortable.
    </p>
    <div class="button-row">
      <a class="pill-button" href="/ai-assistant">Chat on Telegram</a>
      <a class="pill-button secondary" href="/study-tools">Try study tools</a>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- 🟣 HERO BUBBLE – THE CIRCLE (ADDED)                          -->
  <!-- ============================================================ -->
  <div class="hero-panel">
    <div class="hero-bubble-wrap">
      <div class="hero-bubble">
        <span class="emoji-big">🌸</span>
        <h3>Study Buddy</h3>
        <p>calm · clear · confident</p>
      </div>
    </div>
  </div>
</section>

<!-- Stats / Streak -->
<div style="display: flex; flex-wrap: wrap; gap: 1.2rem; margin-bottom: 2rem; justify-content: space-between;">
  <div class="streak-chip"><span>🔥</span> Weekly streak: <strong>4 days strong</strong></div>
  <div class="streak-chip"><span>🎯</span> Today's focus: <strong>Confidence + clarity + calm revision</strong></div>
</div>

<!-- Dashboard Cards -->
<section class="section-grid">
  <article class="card clickable-card" data-card-type="study-dashboard" data-card-title="My Learning Summary" data-card-subtitle="A quick view of your current learning progress" role="button" aria-label="Open My Learning Summary">
    <h3>Study dashboard</h3>
    <p>Track your modules, revise slowly, and celebrate small wins.</p>
  </article>
  <article class="card clickable-card" data-card-type="progress-tracker" data-card-title="XP & Level Roadmap" data-card-subtitle="Your current level and upcoming milestones">
    <h3>Progress tracker</h3>
    <p>Visual checkpoints help you see how far you have come.</p>
  </article>
  <article class="card clickable-card" data-card-type="badge-milestones" data-card-title="Badge Milestones" data-card-subtitle="Track your earned badges and next milestone" role="button" aria-label="Open Badge Milestones">
    <h3>Achievement badges</h3>
    <p>Collect badges for steady effort and consistent practice.</p>
  </article>
</section>

<section class="section-block">
  <h2>How the experience works</h2>
  <div class="feature-list">
    <div class="feature-pill">Clear explanations</div>
    <div class="feature-pill">Friendly AI support</div>
    <div class="feature-pill">Self-paced practice</div>
    <div class="feature-pill">Gentle reminders</div>
  </div>
</section>

<section class="section-block">
  <h2>Student stories</h2>
  <div class="testimonial-grid">
    <article class="card testimonial">
      <p>“I finally understand difficult topics without feeling embarrassed.”</p>
      <strong>— Maya, Business Studies</strong>
    </article>
    <article class="card testimonial">
      <p>“The study tools make revision feel less overwhelming.”</p>
      <strong>— Daniel, Engineering</strong>
    </article>
  </div>
</section>

<section class="section-block">
  <h2>FAQ</h2>
  <div class="faq-list">
    <details class="faq-item">
      <summary>Who is this site for?</summary>
      <p>It is designed for polytechnic students who want a calm, self-paced learning experience.</p>
    </details>
    <details class="faq-item">
      <summary>Can I use it on my phone?</summary>
      <p>Yes, the layout is built to feel friendly and responsive on mobile screens.</p>
    </details>
  </div>
</section>

<div class="modal hidden" id="card-click-modal" role="dialog" aria-modal="true" aria-labelledby="card-click-modal-title">
  <div class="modal-backdrop" id="card-click-backdrop"></div>
  <div class="modal-content">
    <button class="modal-close" id="card-click-close">&times;</button>
    <div class="modal-body">
      <p class="eyebrow" id="card-click-subtitle"></p>
      <h2 id="card-click-modal-title"></h2>
      <div id="card-click-modal-content"></div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>