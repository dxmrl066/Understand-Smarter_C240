<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTube Notes</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: #f4faf6;
      font-family: Arial, Helvetica, sans-serif;
    }

    .page-title {
      color: #2e8b57;
      font-weight: bold;
    }

    .card {
      border: none;
      border-radius: 15px;
    }

    #result {
      white-space: pre-wrap;
      line-height: 1.8;
    }
  </style>
</head>

<body>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-9">

        <!-- Input Card -->
        <div class="card shadow">
          <div class="card-body p-4">
            <h2 class="page-title mb-4">
              📹 Generate Study Notes from YouTube
            </h2>

            <p class="text-muted">
              Paste a YouTube link below and let AI convert the video into organised study notes.
            </p>

            <form id="youtube-form">
              <!-- YouTube Link -->
              <label class="form-label fw-bold">YouTube Link</label>
              <input
                type="text"
                id="youtube-link"
                class="form-control"
                placeholder="https://www.youtube.com/watch?v=...">

              <!-- Note Style Dropdown -->
              <label class="form-label fw-bold mt-3">Note Style</label>
              <select id="note-style" class="form-select">
                <option value="Summary">Summary</option>
                <option value="Detailed">Detailed</option>
                <option value="Revision">Revision</option>
                <option value="Cheatsheet">Cheatsheet</option>
              </select>

              <!-- Generate Button -->
              <button type="submit" class="btn btn-success mt-3">
                Generate Notes
              </button>
            </form>
          </div>
        </div>

        <!-- Results Card -->
        <div class="card shadow mt-4">
          <div class="card-header bg-success text-white">
            📚 AI Study Notes
          </div>
          <div class="card-body">
            <div id="loading" style="display:none;">
              <div class="spinner-border text-success"></div>
              <p class="mt-3">Generating study notes...</p>
            </div>

            <div id="youtube-result">
              Your notes will appear here.
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="/js/gamification.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
