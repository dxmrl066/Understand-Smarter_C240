<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Understand Smarter</title>
  <meta name="description" content="<%= description %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  
  <!-- 🌸 FLOWER CSS -->
  <style>
    .flower-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }
    .flower-bg .flower {
      position: absolute;
      font-size: 2.5rem;
      animation: floatFlower var(--duration, 8s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
      filter: drop-shadow(0 0 15px rgba(255, 182, 193, 0.2));
      transition: transform 0.3s ease, filter 0.3s ease;
      will-change: transform;
      opacity: 0.7;
    }
    .flower-bg .flower:hover {
      transform: scale(1.3) rotate(20deg) !important;
      filter: drop-shadow(0 0 30px rgba(255, 105, 180, 0.5));
      opacity: 1;
    }
    @keyframes floatFlower {
      0% { transform: translateY(0) rotate(0deg) scale(1); }
      25% { transform: translateY(-18px) rotate(8deg) scale(1.05); }
      50% { transform: translateY(-8px) rotate(-4deg) scale(0.95); }
      75% { transform: translateY(-25px) rotate(12deg) scale(1.08); }
      100% { transform: translateY(0) rotate(0deg) scale(1); }
    }
    .flower-1 { top: 3%; left: 2%; font-size: 3.2rem; --duration: 7s; --delay: 0s; }
    .flower-2 { top: 8%; right: 4%; font-size: 2.6rem; --duration: 8.5s; --delay: 1.2s; }
    .flower-3 { top: 22%; left: 1%; font-size: 3.8rem; --duration: 9s; --delay: 2.5s; }
    .flower-4 { top: 18%; right: 2%; font-size: 2.8rem; --duration: 7.5s; --delay: 0.8s; }
    .flower-5 { top: 45%; left: 0%; font-size: 3.4rem; --duration: 8.2s; --delay: 3.2s; }
    .flower-6 { top: 50%; right: 1%; font-size: 3.6rem; --duration: 9.5s; --delay: 1.8s; }
    .flower-7 { top: 72%; left: 2%; font-size: 2.8rem; --duration: 7.8s; --delay: 4s; }
    .flower-8 { bottom: 3%; right: 3%; font-size: 3.2rem; --duration: 8.8s; --delay: 2.2s; }
    .flower-9 { top: 12%; left: 18%; font-size: 2rem; --duration: 6.8s; --delay: 3.5s; }
    .flower-10 { top: 65%; left: 18%; font-size: 2.4rem; --duration: 7.2s; --delay: 1.5s; }
    .flower-11 { top: 40%; left: 10%; font-size: 1.8rem; --duration: 6.5s; --delay: 4.5s; }
    .flower-12 { top: 30%; right: 8%; font-size: 2.2rem; --duration: 7.6s; --delay: 0.3s; }
    .flower-13 { bottom: 18%; left: 8%; font-size: 2.8rem; --duration: 8.9s; --delay: 3.8s; }
    .flower-14 { bottom: 25%; right: 6%; font-size: 2rem; --duration: 7.1s; --delay: 1.1s; }
    .flower-15 { top: 55%; left: 22%; font-size: 1.6rem; --duration: 9.2s; --delay: 5s; }
    .flower-16 { bottom: 42%; left: 4%; font-size: 2.6rem; --duration: 8.4s; --delay: 2.8s; }
    .flower-17 { top: 2%; left: 35%; font-size: 1.8rem; --duration: 7.3s; --delay: 4.2s; }
    .flower-18 { bottom: 8%; left: 25%; font-size: 2.2rem; --duration: 8.1s; --delay: 0.7s; }
    .flower-19 { top: 48%; left: 30%; font-size: 1.4rem; --duration: 6.9s; --delay: 3.3s; }
    .flower-20 { bottom: 32%; right: 12%; font-size: 2rem; --duration: 7.7s; --delay: 2.1s; }
    .flower-21 { top: 78%; left: 12%; font-size: 2.4rem; --duration: 8.6s; --delay: 1.7s; }
    .flower-22 { top: 15%; left: 45%; font-size: 1.7rem; --duration: 6.3s; --delay: 4.8s; }
    .flower-23 { bottom: 12%; right: 18%; font-size: 2.1rem; --duration: 7.9s; --delay: 0.5s; }
    .flower-24 { top: 35%; left: 6%; font-size: 2.3rem; --duration: 8.7s; --delay: 3.1s; }
    .flower-25 { top: 60%; right: 6%; font-size: 1.9rem; --duration: 7.4s; --delay: 2.6s; }
    .flower-bg .flower:nth-child(odd) {
      filter: drop-shadow(0 0 20px rgba(255, 182, 193, 0.3)) drop-shadow(0 0 40px rgba(255, 182, 193, 0.1));
    }
    .flower-bg .flower:nth-child(even) {
      filter: drop-shadow(0 0 20px rgba(184, 159, 245, 0.25)) drop-shadow(0 0 40px rgba(184, 159, 245, 0.08));
    }
    .flower-bg .flower:nth-child(3n) {
      filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.2)) drop-shadow(0 0 40px rgba(255, 215, 0, 0.08));
    }
    .topbar, .page-shell, .site-footer {
      position: relative;
      z-index: 1;
    }
    @media (max-width: 860px) {
      .flower-bg .flower { font-size: 1.6rem !important; opacity: 0.4 !important; }
    }
    @media (max-width: 480px) {
      .flower-bg .flower { font-size: 1.2rem !important; }
    }
  </style>
</head>
<body>

  <!-- 🌸 FLOWER HTML – PASTE RIGHT AFTER <body> -->
  <div class="flower-bg">
    <span class="flower flower-1">🌸</span>
    <span class="flower flower-2">🌺</span>
    <span class="flower flower-3">🌻</span>
    <span class="flower flower-4">🌹</span>
    <span class="flower flower-5">🌷</span>
    <span class="flower flower-6">🌼</span>
    <span class="flower flower-7">🌸</span>
    <span class="flower flower-8">🌺</span>
    <span class="flower flower-9">🌻</span>
    <span class="flower flower-10">🌹</span>
    <span class="flower flower-11">🌷</span>

  </div>

  <!-- Top Bar -->
  <header class="topbar" style="position: relative; display: flex; align-items: center; justify-content: space-between;">
    
    <!-- Changed: Added absolute positioning, height, and alignment to the anchor -->
    <a class="brand" href="/" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; padding: 0; z-index: 10;">
        <img 
          src="/images/logo.png" 
          alt="Understand Smarter Logo" 
          style="height: 115px; width: auto; object-fit: contain; transition: transform 0.2s ease;" 
          onmouseover="this.style.transform='scale(1.05)'" 
          onmouseout="this.style.transform='scale(1)'"
          onerror="this.src='Untitled_design__2_-removebg-preview.png'"
        />
    </a>
    
    <!-- Note: You might need to add a margin-left here so the links don't overlap the logo -->
    <nav class="nav-links" style="margin-left: auto;">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/ai-assistant" class="<%= page === 'ai-assistant' ? 'active' : '' %>">AI Assistant</a>
      <a href="/study-tools" class="<%= page === 'study-tools' ? 'active' : '' %>">Study Tools</a>
      <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a>
      <a href="/resources" class="<%= page === 'resources' ? 'active' : '' %>">Resources</a>
      <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a>
    </nav>
</header>

  <main class="page-shell">